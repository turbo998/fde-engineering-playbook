{
  "name": "fde-engineering-playbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.13.1 <25" },
  "workspaces": ["apps/seed", "packages/contracts", "packages/lab"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/seed/vite.config.ts",
    "start": "node dist/apps/seed/src/main.js",
    "dev:api": "tsx apps/seed/src/main.ts",
    "dev:web": "vite --config apps/seed/vite.config.ts",
    "preflight": "tsx packages/lab/src/runner.ts preflight",
    "benchmark": "tsx packages/lab/src/runner.ts measured",
    "smoke:offline": "tsx scripts/smoke-offline.ts",
    "check:public": "tsx scripts/check-public.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke:offline && npm run check:public"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@github/copilot-sdk": "1.0.15",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
